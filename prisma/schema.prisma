generator client {
  provider = "prisma-client"
  output   = "./generated/"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user         String            @db.Uuid
  cat_type        String            @default("EXPENSE") @db.VarChar(7)
  cat_name        String            @db.VarChar(255)
  users           users             @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  money_movements money_movements[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model money_movements {
  id                                                 String        @id(map: "money_movement_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user                                            String        @db.Uuid
  id_category                                        String?       @db.Uuid
  title                                              String        @db.VarChar(255)
  description                                        String?
  amount                                             Decimal       @db.Decimal(10, 2)
  logged_for                                         DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  logged_at                                          DateTime?     @default(now()) @db.Timestamptz(6)
  id_account                                         String?       @db.Uuid
  movement_type                                      movement_type @default(EXPENSE)
  id_account_source                                  String?       @db.Uuid
  categories                                         categories?   @relation(fields: [id_category], references: [id], onUpdate: NoAction, map: "money_movement_id_category_fkey")
  users                                              users         @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "money_movement_id_user_fkey")
  account                                            account?      @relation(fields: [id_account], references: [id], onUpdate: NoAction)
  account_money_movements_id_account_sourceToaccount account?      @relation("money_movements_id_account_sourceToaccount", fields: [id_account_source], references: [id], onUpdate: NoAction)
}

model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String            @db.VarChar(255)
  email           String            @unique @db.VarChar(255)
  password_hash   String            @db.VarChar(60)
  currency        String            @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  account         account[]
  categories      categories[]
  money_movements money_movements[]
  weekly_reminder weekly_reminder[]
}

model account {
  id                                                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user                                                    String            @db.Uuid
  name                                                       String            @db.VarChar(50)
  created_at                                                 DateTime?         @default(now()) @db.Timestamptz(6)
  users                                                      users             @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  money_movements                                            money_movements[]
  money_movements_money_movements_id_account_sourceToaccount money_movements[] @relation("money_movements_id_account_sourceToaccount")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model weekly_reminder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user     String   @db.Uuid
  day_of_week Int      @db.SmallInt
  time        DateTime @db.Time(6)
  users       users    @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum movement_type {
  EXPENSE
  INCOME
  TRANSFERT
}
